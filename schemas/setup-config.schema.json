{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agents-cli setup configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "suite",
    "tracker"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "enum": [
        "codex",
        "opencode",
        "claude",
        "pi"
      ]
    },
    "suite": {
      "enum": [
        "complete",
        "backend",
        "frontend",
        "review-qa",
        "custom"
      ]
    },
    "tracker": {
      "enum": [
        "none",
        "linear",
        "trello"
      ]
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^global-[a-z-]+$"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/externalSkill"
          }
        ]
      }
    },
    "mcps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "github",
          "linear",
          "trello",
          "jev"
        ]
      }
    },
    "decisionSupport": {
      "$ref": "#/$defs/decision"
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "typesafe"
        },
        "mode": {
          "enum": [
            "off",
            "shadow",
            "assist"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^jev-[a-zA-Z0-9.-]+$"
        },
        "apiKeyEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "route-task",
              "suggest-skills",
              "classify-failure",
              "rank-test-scenarios"
            ]
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route-task": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "suggest-skills": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "classify-failure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rank-test-scenarios": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "audit": {
          "type": "boolean"
        }
      }
    },
    "externalSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "revision",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "description": "Structural schema; CLI additionally validates catalog membership, dependency resolution, endpoint security and safe resource paths."
}
